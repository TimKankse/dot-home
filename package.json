{
  "name": "dot-home",
  "version": "0.1.22",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run db:sync",
    "db:sync": "node --env-file-if-exists=.env scripts/prepare-database.mjs && prisma db push --skip-generate",
    "build": "next build --webpack",
    "start": "node server.js",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "security:migrate-integrations": "node --env-file-if-exists=.env --import tsx scripts/migrate-integration-configs.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:full": "npm run check && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "gridstack": "^12.3.3",
    "ical-expander": "^3.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.555.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-fast-compare": "^3.2.2",
    "rss-parser": "^3.13.0",
    "uuid": "^13.0.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/lodash": "^4.17.21",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^27.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.0",
      "effect": "3.22.5"
    }
  },
  "engines": {
    "node": ">=24 <25"
  }
}
